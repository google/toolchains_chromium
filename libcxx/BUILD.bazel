load("//libcxx:bootstrap.bzl", "libcxx_bootstrap_flag")

package(default_visibility = ["//visibility:public"])

# True while the C++ runtime itself is being built; see bootstrap.bzl.
libcxx_bootstrap_flag(
    name = "bootstrap",
    build_setting_default = False,
)

config_setting(
    name = "bootstrap_on",
    flag_values = {":bootstrap": "True"},
)

# The toolchain's runtime libraries in the bootstrap configuration.
filegroup(
    name = "empty",
    srcs = [],
)
